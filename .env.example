# ==============================================================================
# WhatsApp Automation Mobile App & Bot Server - Environment Variables
# Copy this file to .env and configure with your specific values.
# Variables with the EXPO_PUBLIC_ prefix are automatically injected by Expo.
# ==============================================================================

# Wi-Fi Target Configuration (Router SSID to trigger WhatsApp message upon connection)
EXPO_PUBLIC_DEFAULT_TARGET_SSID=Your_WiFi_SSID

# WhatsApp Bot Server Configuration (Local IP or domain of your WhatsApp Bot server)
EXPO_PUBLIC_BOT_URL=http://192.168.1.100:3001

# Optional Default Message Template (Leaves blank by default for user custom input)
EXPO_PUBLIC_DEFAULT_MESSAGE_TEMPLATE=

# Bot Server Local Settings
PORT=3001
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
PUPPETEER_HEADLESS=true
